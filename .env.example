APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=America/El_Salvador
APP_SESSION_SECRET=generate-a-random-value-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=480
ALLOWED_ORIGINS=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-me

META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=replace-me
META_ACCESS_TOKEN=replace-me
META_VERIFY_TOKEN=replace-me
META_APP_SECRET=replace-me

GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# Optional browser-safe services. Never place private tokens here.
WEATHER_API_KEY=
OPENWEATHERMAP_API_KEY=

REMINDER_POLL_SECONDS=60
SESSION_TTL_SECONDS=300
ENABLE_REMINDER_SCHEDULER=false
REDIS_URL=
RATE_LIMIT_LOGIN=10
RATE_LIMIT_AI=30
RATE_LIMIT_API=120

